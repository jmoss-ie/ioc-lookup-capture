{
  "manifest_version": 3,
  "name": "IOC Lookup Capture",
  "version": "1.5.0",
  "description": "Captures reputation-lookup screenshots for incident reports.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "offscreen",
    "debugger"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116"
}
